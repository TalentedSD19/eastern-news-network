{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "eastern-news-network",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eastern-news-network",
			// Replace with the id printed by `wrangler d1 create eastern-news-network`
			"database_id": "00000000-0000-0000-0000-000000000000",
			// SQL files generated with `prisma migrate diff`, applied with `wrangler d1 migrations apply`
			"migrations_dir": "prisma/migrations"
		}
	]
	// No "images" binding on purpose: Cloudflare Images bills per transformation,
	// and without it /_next/image serves the original file untouched.
	// Secrets (NEXTAUTH_SECRET, VAPID_PRIVATE_KEY, ...) go in `wrangler secret put`
	// and, locally, .dev.vars — never in this file.
}
